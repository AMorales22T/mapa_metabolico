    {
      "id": "dae8f719",
      "type": "text",
      "x": 990,
      "y": 900,
      "width": 600,
      "height": 40,
      "text": "CADENA RESPIRATORIA & FOSFORILACIÓN OXIDATIVA\nMembrana Interna / Crestas:\nComplejo I (NADH DH) ➔ Q ➔ Complejo III ➔ Citocromo c ➔ Complejo IV (O₂ ➔ H₂O)\nComplejo II (Succinato DH de Krebs alimenta FADH₂ directo a Q)\nGradiente electroquímico de H⁺ en Espacio Intermembrana ➔ FoF1 ATP Sintasa",
      "originalText": "CADENA RESPIRATORIA & FOSFORILACIÓN OXIDATIVA\nMembrana Interna / Crestas:\nComplejo I (NADH DH) ➔ Q ➔ Complejo III ➔ Citocromo c ➔ Complejo IV (O₂ ➔ H₂O)\nComplejo II (Succinato DH de Krebs alimenta FADH₂ directo a Q)\nGradiente electroquímico de H⁺ en Espacio Intermembrana ➔ FoF1 ATP Sintasa",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#0369a1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
