    {
      "type": "text",
      "id": "txt_evidence",
      "x": 880,
      "y": 200,
      "width": 260,
      "height": 285,
      "text": "ESTEQUIOMETRÍA ENERGÉTICA\nPALMITATO (C16H32O2)\n\n• Ciclos Lynen: 7\n• FADH2 producidos: 7 x 1.5 ATP\n  = 10.5 ATP\n• NADH producidos:  7 x 2.5 ATP\n  = 17.5 ATP\n• Acetil-CoA:      8 x 10 ATP\n  = 80.0 ATP\n────────────────────────────\nSubtotal bruto:   108 ATP\nGasto activación:  -2 ATP\n(ATP -> AMP + 2 Pi)\n────────────────────────────\nTOTAL NETO:       106 ATP\n\nEficiencia: ~33%\nH2O metabólica: 23 H2O",
      "originalText": "ESTEQUIOMETRÍA ENERGÉTICA\nPALMITATO (C16H32O2)\n\n• Ciclos Lynen: 7\n• FADH2 producidos: 7 x 1.5 ATP\n  = 10.5 ATP\n• NADH producidos:  7 x 2.5 ATP\n  = 17.5 ATP\n• Acetil-CoA:      8 x 10 ATP\n  = 80.0 ATP\n────────────────────────────\nSubtotal bruto:   108 ATP\nGasto activación:  -2 ATP\n(ATP -> AMP + 2 Pi)\n────────────────────────────\nTOTAL NETO:       106 ATP\n\nEficiencia: ~33%\nH2O metabólica: 23 H2O",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
